# GEOFUSION Frontend Environment Variables
# ONLY public client-safe keys should ever be defined here.
# NEVER include SUPABASE_SERVICE_ROLE_KEY or any secret database credentials.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Mapbox token for basemap. If omitted, MapLibre + CartoDB Dark tiles are used.
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token-here

